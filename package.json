{
  "name": "@sandsoftwaresolutions/atomic-file",
  "version": "0.1.1",
  "description": "Write files atomically so a crash or power cut never leaves half a file. JSON helpers that never mistake a corrupt file for a missing one.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "file",
    "atomic",
    "write",
    "json",
    "fsync"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-atomic-file.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-atomic-file/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-atomic-file#readme",
  "publishConfig": {
    "access": "public"
  }
}
